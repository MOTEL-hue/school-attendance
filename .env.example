# העתיקו ל-.env והתאימו. בענן (Render) מגדירים את אלה כמשתני סביבה.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# בייצור: כתובת PostgreSQL. ריק = SQLite מקומי.
DATABASE_URL=
# סיסמת בעל המערכת (משתמש admin), נוצרת בהפעלה ראשונה
ADMIN_PASSWORD=change-me
# פרטי יצירת קשר שיופיעו בתנאי השימוש ובמדיניות הפרטיות
OWNER_CONTACT=
