# העתיקו ל-.env והתאימו. בענן (Render) מגדירים את אלה כמשתני סביבה.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# בייצור: כתובת PostgreSQL. ריק = SQLite מקומי.
DATABASE_URL=
# סיסמת מנהל האתר (נוצרת אוטומטית בהפעלה אם אין משתמש)
ADMIN_PASSWORD=change-me
# מפתח סודי לטלפון: חלק מהכתובת ש-ימות המשיח פונה אליה
PHONE_SECRET=change-me-too
